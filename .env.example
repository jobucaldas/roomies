# Roomies baseline environment template
# Copy to .env and replace every placeholder.

# Core backend
DATABASE_URL=sqlite://roomies.db
PORT=8080
WORKER_HEALTH_PORT=8081
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost
INVITATION_TTL_HOURS=168
JOB_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=30

# Production PostgreSQL (set one of these instead of the SQLite URL above)
# DATABASE_URL=postgres://roomies:replace-me@postgres.example:5432/roomies?sslmode=require
# POSTGRES_PASSWORD=replace-me

# SMTP (Mailpit in dev/test; SMTP_HOST selects real SMTP delivery in every environment.
# Leave SMTP_HOST empty only to use the fake, non-delivering provider.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Roomies <no-reply@roomies.local>
# Required whenever SMTP_HOST is set. Generate locally for Mailpit/tests; never commit it.
INVITATION_DELIVERY_KEY_ID=initial-2025
INVITATION_DELIVERY_KEY=replace-with-base64-encoded-32-byte-aes-key
# Comma-separated prior key-id:base64-key entries retained until every pending
# invitation encrypted under them is terminal (accepted, revoked, expired, or delivered).
INVITATION_DELIVERY_OLD_KEYS=

# Blob storage
BLOB_STORAGE_DRIVER=filesystem
BLOB_STORAGE_PATH=./.roomies/blob
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:no-reply@roomies.local
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Runtime / release
ROOMIES_PUBLIC_BASE_URL=http://localhost
ROOMIES_API_URL=http://localhost:8080/api
TIMEZONE=UTC
