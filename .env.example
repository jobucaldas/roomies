# Roomies baseline environment template
# Copy to .env and replace every placeholder.

# Core backend
DATABASE_URL=sqlite://roomies.db
PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost

# Production PostgreSQL (set one of these instead of the SQLite URL above)
# DATABASE_URL=postgres://roomies:replace-me@postgres.example:5432/roomies?sslmode=require
# POSTGRES_PASSWORD=replace-me

# SMTP (Mailpit in dev/test)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Roomies <no-reply@roomies.local>

# Blob storage
BLOB_STORAGE_DRIVER=filesystem
BLOB_STORAGE_PATH=./.roomies/blob
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:no-reply@roomies.local
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Runtime / release
ROOMIES_PUBLIC_BASE_URL=http://localhost
ROOMIES_API_URL=http://localhost:8080/api
TIMEZONE=UTC
