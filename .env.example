# Copy to .env and fill in what you need. Every value is optional for the
# development stack (docker-compose.yml); the README compose file marks the
# required ones.

# Database password, used only between containers: openssl rand -hex 24
POSTGRES_PASSWORD=
# Public origin of the app (scheme + host + port). Its port must match HTTP_PORT.
ROOMIES_PUBLIC_BASE_URL=http://localhost:8080
# HTTP_PORT=8080
# Required unless ROOMIES_PUBLIC_BASE_URL is localhost: openssl rand -hex 48
JWT_SECRET=

# WorkOS AuthKit. Leave both blank for local email/password sign-in.
# Register {ROOMIES_PUBLIC_BASE_URL}/callback as a redirect URI in WorkOS.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Invitation email over SMTP. Leave SMTP_HOST blank to skip delivery.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Roomies <no-reply@roomies.local>
# Required with SMTP_HOST: openssl rand -base64 32
INVITATION_DELIVERY_KEY_ID=initial
INVITATION_DELIVERY_KEY=

# Web Push. Leave blank to skip delivery.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Required with Web Push: openssl rand -base64 32
NOTIFICATION_DELIVERY_KEY_ID=initial
NOTIFICATION_DELIVERY_KEY=
