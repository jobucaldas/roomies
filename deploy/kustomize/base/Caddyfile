:8080

header {
	Referrer-Policy "no-referrer"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	# Flutter ships CanvasKit locally (--no-web-resources-cdn). Engine still fetches
	# fallback Roboto over fetch(), which needs connect-src fonts.gstatic.com (font-src alone is not enough).
	Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
}

root * /usr/share/caddy/html
file_server

handle /api/* {
	reverse_proxy roomies-backend:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

handle {
    rewrite * /index.html
    file_server
}
