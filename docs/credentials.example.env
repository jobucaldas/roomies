# Roomies credential template
# Use this file as the source for .env, Kubernetes Secrets, or your secret manager.

DATABASE_URL=postgres://roomies:replace-me@postgres.example:5432/roomies?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Roomies <no-reply@example.com>
# base64-encoded 32-byte AES-256 key; distinct from JWT_SECRET
INVITATION_DELIVERY_KEY_ID=initial-2025
INVITATION_DELIVERY_KEY=replace-with-base64-encoded-32-byte-aes-key
# Retain prior key-id:base64-key entries during rotation for pending/retrying jobs.
INVITATION_DELIVERY_OLD_KEYS=

S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=roomies
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

WEB_PUSH_PUBLIC_KEY=replace-me
WEB_PUSH_PRIVATE_KEY=replace-me
WEB_PUSH_SUBJECT=mailto:no-reply@example.com
FCM_PROJECT_ID=replace-me
FCM_CREDENTIALS_JSON={}

ROOMIES_PUBLIC_BASE_URL=https://roomies.example.com
ROOMIES_API_URL=https://roomies.example.com/api
WORKER_HEALTH_PORT=8081
INVITATION_TTL_HOURS=168
JOB_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=30
TIMEZONE=UTC
